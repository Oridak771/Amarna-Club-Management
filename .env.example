AMARNA_DB_PORT=5432
AMARNA_DB_NAME=postgres
AMARNA_DB_USERNAME=biuser
AMARNA_DB_PASSWORD=
AMARNA_DB_SSL_MODE=disable

# --- Odoo JSON-RPC ---
